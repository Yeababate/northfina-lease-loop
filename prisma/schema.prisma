// Database schema. Change it, then run `npm run db:migrate -- --name <what_changed>`.
// Never hand-write files in prisma/migrations/: the Prisma CLI generates them.
// SQLite has no enums here, so allowed values (category, condition, status) are
// checked with Zod in src/data/schemas.ts before anything is written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One physical item that can be leased, returned, refurbished and leased again.
// Mirrors data/assets.json; `usage` is stored as two columns.
model Asset {
  id             String   @id
  category       String // e_bike | laptop | farm_machine
  make           String
  model          String
  model_year     Int
  serial_number  String   @unique
  condition      String // new | like_new | good | fair | poor
  usage_unit     String // km | battery_cycles | engine_hours
  usage_value    Int
  previous_lives Int
  status         String // available | reserved | returned
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([category])
}

// Who changed what, and when. Written in the same transaction as the change
// (see src/server/audit.ts), so a change without an audit row cannot exist.
model AuditLog {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now())
  actor        String
  action       String // e.g. asset.status_changed
  entity_type  String // e.g. asset
  entity_id    String
  details_json String? // JSON text, e.g. {"from":"available","to":"reserved"}

  @@index([entity_type, entity_id])
  @@index([created_at])
}

// Immutable signing snapshot; later catalogue changes never update this row.
model Contract {
  invoices           Invoice[]
  id                 String @id
  actor              String
  assetId            String
  /// First day of the lease, chosen by the customer. On or after signedOn.
  startOn            String
  endOn              String
  signedOn           String
  termMonths         Int
  downPaymentCents   Int
  listPriceCents     Int
  priceListVersion   Int
  coefficientVersion Int
  coefficientId      String
  band               String
  factor             Float
  financedCents      Int
  monthlyNetCents    Int
  buyoutNetCents     Int

  @@index([assetId])
}

// Immutable rental invoice. A billing period can only be issued once per contract.
model Invoice {
  id           String @id
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  period       Int
  invoiceDate  String
  dueDate      String
  netCents     Int
  vatPercent   Float
  vatCents     Int
  grossCents   Int

  @@unique([contractId, period])
}

// A provider's grouping of physical items meant to be leased together. No prices: it only
// says which assets belong together and for which terms. Editing bumps `revision`.
model BundleOffer {
  id          String            @id
  providerId  String
  name        String
  description String
  /// Supported terms in months as JSON text, e.g. [24,36].
  terms_json  String
  published   Boolean           @default(false)
  revision    Int               @default(1)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  items       BundleOfferItem[]

  @@index([providerId])
}

// One distinct physical asset in a bundle. An asset appears at most once per bundle.
model BundleOfferItem {
  offerId  String
  offer    BundleOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  assetId  String
  /// The provider's display order, starting at 0.
  position Int

  @@id([offerId, assetId])
  @@index([assetId])
}
